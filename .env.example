# Generate with: bun run gen-key >> .env
AUTH_PRIVATE_KEY=

PORT=4000
AUTH_ISSUER=http://localhost:4000
# Services allowed to accept the tokens (comma-separated)
AUTH_AUDIENCE=blob_storage,todos_service
# The browser frontend's origin
CORS_ORIGIN=http://localhost:5173
# Set to false only for local http development
COOKIE_SECURE=true
# true only when requests arrive through api_gateway, which sets X-Forwarded-For
TRUST_PROXY=false
DB_PATH=./auth.sqlite
